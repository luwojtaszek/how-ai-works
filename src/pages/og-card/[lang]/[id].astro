---
// 1200×630 social preview card. Not linked or indexed: scripts/og.sh screenshots these
// into public/og/<lang>/<id>.png, which pages reference as og:image.
import { LANGS, UI, content } from '../../../i18n.js';
import { ORDER } from '../../../data.js';

export const getStaticPaths = () => LANGS.flatMap((lang) => ['home', ...ORDER].map((id) => ({ params: { lang, id } })));
const { lang, id } = Astro.params;
const ui = UI[lang], c = content(lang);
const home = id === 'home';
const gi = home ? -1 : c.groups.findIndex((g) => g[2].includes(id));
const title = home ? (lang === 'pl' ? 'Jak działa AI, od środka' : 'How AI works, from the inside') : c.titleOf(id);
const kicker = home ? ui.tagline : `${ui.chapter} ${gi + 1} · ${c.groups[gi][0]}`;
const sub = home ? ui.siteDesc.split('. ')[0] + '.' : c.x(id).d;
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8"><meta name="robots" content="noindex">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Spectral:wght@400;500&display=block" rel="stylesheet">
<style>
  html,body{margin:0;width:1200px;height:630px;overflow:hidden;background:#15171A;color:#ECEAE4;font-family:"IBM Plex Sans",sans-serif}
  .card{position:relative;box-sizing:border-box;width:1200px;height:630px;padding:64px 72px;display:flex;flex-direction:column}
  .top{display:flex;justify-content:space-between;font:600 20px/1 "IBM Plex Sans";letter-spacing:.12em;text-transform:uppercase;color:#E6AE4A}
  .top span:last-child{color:#9A9C9E;letter-spacing:.02em;text-transform:none;font-weight:500}
  .kicker{margin-top:auto;font:500 24px/1.3 "IBM Plex Sans";color:#9A9C9E}
  h1{margin:14px 0 0;max-width:900px;font:500 76px/1.06 "Spectral",serif;letter-spacing:-.01em}
  p{margin:22px 0 0;max-width:820px;font:400 28px/1.35 "IBM Plex Sans";color:#C8C6C0}
  svg{position:absolute;right:56px;top:120px;opacity:.9}
</style>
</head>
<body>
  <div class="card">
    <div class="top"><span>{ui.siteName}</span><span>{Astro.site?.host}</span></div>
    <svg width="300" height="190" viewBox="0 0 300 190" fill="none" stroke="#E6AE4A" stroke-linecap="round">
      <path d="M280 180 Q150 -40 20 180" stroke-width="9" opacity=".95"/><path d="M280 180 Q195 30 110 180" stroke-width="5" opacity=".6"/>
      <path d="M280 180 Q230 90 180 180" stroke-width="3" opacity=".4"/><circle cx="280" cy="180" r="7" fill="#E6AE4A" stroke="none"/>
    </svg>
    <div class="kicker">{kicker}</div>
    <h1>{title}</h1>
    <p>{sub}</p>
  </div>
</body>
</html>
